# Conduit Backend — Environment Variables
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.
#
# All fields have sensible defaults. Only override what you need.

# -----------------------------------------------------------------------
# Paths
# -----------------------------------------------------------------------

# Directory where runtime data (DB, scripts, logs, tmp) is stored.
# Defaults to <repo_root>/data/
# DATA_DIR=/absolute/path/to/data

# Path to the Fernet encryption key file. Generated automatically on first run.
# Defaults to <repo_root>/data/.secret_key
# SECRET_KEY_PATH=/absolute/path/to/.secret_key

# -----------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------

# SQLAlchemy connection string. Defaults to SQLite in the data directory.
# DATABASE_URL=sqlite:////absolute/path/to/conduit.db

# -----------------------------------------------------------------------
# Concurrency
# -----------------------------------------------------------------------

# Maximum number of scripts that can run simultaneously.
# Scripts beyond this limit are queued and run as slots open.
# MAX_CONCURRENT_SCRIPTS=10

# -----------------------------------------------------------------------
# Metrics & monitoring
# -----------------------------------------------------------------------

# How often (in seconds) system metrics are collected.
# METRICS_INTERVAL_SECONDS=30

# Fraction of resource usage that triggers a WARN notification (0.0–1.0).
# WARN_THRESHOLD=0.75

# Fraction of resource usage that triggers a CRITICAL notification (0.0–1.0).
# CRITICAL_THRESHOLD=0.90

# -----------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------

# Comma-separated list of allowed origins for CORS.
# Cannot use "*" — must be explicit origins (enforced by config validation).
# CORS_ALLOWED_ORIGINS=http://localhost:5173,https://yourapp.com

# -----------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------

# Set to true to require a valid JWT token on all API requests.
# When false (default), the platform is open — safe for local dev only.
# AUTH_ENABLED=false

# Secret used to sign JWT tokens. Auto-generated per process if not set.
# IMPORTANT: Set this in production or tokens are invalidated on every restart.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
# JWT_SECRET=<long-random-hex-string>

# How long issued tokens remain valid (hours). Default: 24.
# JWT_EXPIRY_HOURS=24

# -----------------------------------------------------------------------
# Encryption key (backup / multi-instance)
# -----------------------------------------------------------------------

# If set, the platform uses this Fernet key instead of the on-disk key file.
# Use this to inject the key from AWS Secrets Manager, HashiCorp Vault, etc.
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ENCRYPTION_KEY=<base64url-fernet-key>

# -----------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------

# Log verbosity. One of: DEBUG, INFO, WARNING, ERROR, CRITICAL.
# LOG_LEVEL=INFO
