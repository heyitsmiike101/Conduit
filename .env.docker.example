# Conduit Docker Environment Variables
# Copy this file to .env to customize Conduit behavior

# ─── Persistent Data Directory ────────────────────────────────────────────
# Where to store Conduit data on the host machine
# Examples:
#   ./conduit-data          — current directory (relative path)
#   /mnt/data/conduit       — absolute path
#   /data/conduit           — mounted network storage
# Default: ./conduit-data (creates 'conduit-data' folder in current directory)
DATA_DIR_HOST=./conduit-data

# ─── Port Configuration ───────────────────────────────────────────────────
# Backend API port
BACKEND_PORT=8000

# Frontend development server port (change if 5173 is in use)
FRONTEND_PORT=5173

# ─── Script Execution Configuration ───────────────────────────────────────
# Maximum number of scripts that can run concurrently
MAX_CONCURRENT_SCRIPTS=10

# Timeout (seconds) for script execution — 0 or omitted = no timeout
# Scripts exceeding this are terminated with SIGTERM, then SIGKILL
# SCRIPT_TIMEOUT_SECONDS=300

# ─── System Monitoring & Alerts ───────────────────────────────────────────
# How often (seconds) to collect CPU/memory/disk metrics
METRICS_INTERVAL_SECONDS=30

# CPU/Memory/Disk warning threshold (0.0–1.0, default 0.75 = 75%)
WARN_THRESHOLD=0.75

# Critical threshold for alerts (0.0–1.0, default 0.90 = 90%)
CRITICAL_THRESHOLD=0.90

# ─── Logging ──────────────────────────────────────────────────────────────
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ─── CORS Configuration ───────────────────────────────────────────────────
# Comma-separated list of allowed origins for CORS requests
# For development: http://localhost:5173
# For production: https://yourdomain.com
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ─── Authentication (Optional, disabled by default) ────────────────────────
# Enable authentication: true or false
# Default: false (development mode, no auth required)
AUTH_ENABLED=false

# JWT signing secret — change to a strong random string in production!
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=dev-secret-change-in-production

# JWT token expiry (hours)
JWT_EXPIRY_HOURS=24

# ─── Encryption (Auto-generated if not specified) ────────────────────────
# Fernet encryption key for variables
# Auto-generated and stored in /data/.secret_key if not provided
# To rotate: generate new key and re-encrypt variables (Iteration 2 feature)
# ENCRYPTION_KEY=your-base64-fernet-key-here
