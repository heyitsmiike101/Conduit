# Version control
.git
.gitignore
.gitattributes

# Node
node_modules
npm-debug.log*
yarn-error.log*
.npm

# Python
__pycache__
*.py[cod]
*$py.class
*.so
.Python
venv/
ENV/
env/
*.egg-info/
.eggs/
.pytest_cache/
.coverage
.tox/
backend/tests/

# Frontend build output — built fresh inside Docker; local dist not needed
frontend/dist/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Runtime / secrets — never bake data or credentials into the image
data/
conduit-data/
*.db
*.db-wal
*.db-shm
.secret_key
.env
.env.*
!.env.docker.example

# Logs
*.log

# CI/CD
.github/
.gitlab-ci.yml
.circleci/

# Documentation (not needed at runtime)
docs/
*.md
LICENSE

# Docker files themselves (not needed in build context)
Dockerfile*
docker-compose*.yml
.dockerignore
